{
  "name": "cambridge-vocab-quest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host",
    "dev:api": "tsx watch server/index.ts",
    "start:api": "node dist-server/server/index.js",
    "build:api": "tsc -p tsconfig.server.build.json",
    "seed": "tsx server/seed.ts",
    "parent:create": "tsx server/admin-parent.ts create",
    "parent:reset-password": "tsx server/admin-parent.ts reset-password",
    "vocab:build": "node scripts/build-cambridge-vocab.mjs",
    "vocab:enrich": "node scripts/enrich-vocab.mjs",
    "vocab:choices": "node scripts/rebuild-quiz-choices.mjs",
    "vocab:sentences": "node scripts/generate-kid-sentences.mjs",
    "vocab:facts": "node scripts/generate-kid-facts.mjs",
    "vocab:images": "node scripts/generate-word-images.mjs",
    "vocab:yle-pack": "node scripts/build-yle-content-pack.mjs",
    "vocab:yle-content": "node scripts/apply-yle-content.mjs",
    "vocab:yle-verify": "node scripts/verify-yle-content.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.server.json --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.1.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "fastify": "^5.10.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
